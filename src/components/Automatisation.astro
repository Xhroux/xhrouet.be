---
// Automation block used inside MDX pages:
// <Automatisation nom="..." quand="..." si="..." alors="...">
//   ```yaml
//   ...
//   ```
//   Optional note in Markdown.
// </Automatisation>
interface Props {
  nom: string;
  quand: string;
  si?: string;
  alors: string;
}

const { nom, quand, si, alors } = Astro.props;
---

<section class="automation">
  <p class="automation-kicker">Automatisation</p>
  <h3>{nom}</h3>
  <dl class="qsa">
    <div>
      <dt>Quand</dt>
      <dd>{quand}</dd>
    </div>
    {
      si && (
        <div>
          <dt>Si</dt>
          <dd>{si}</dd>
        </div>
      )
    }
    <div>
      <dt>Alors</dt>
      <dd>{alors}</dd>
    </div>
  </dl>
  <div class="prose">
    <slot />
  </div>
</section>
